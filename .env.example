# Copy to .env.local for local testing, and set the same in Vercel > Project > Settings > Environment Variables.

# Required: your Google Gemini API key (from https://aistudio.google.com/apikey)
GEMINI_API_KEY=your_google_ai_studio_key_here

# Optional: which Gemini IMAGE model to use (the "Nano Banana" family — NOT a chat/Pro text model).
# Change here without touching code. Verify the exact id in Google AI Studio.
#   gemini-3-pro-image-preview   = Nano Banana Pro (Gemini 3 Pro Image) — best text rendering, 2K/4K, ~$0.134/image  [recommended for NAME+NUMBER]
#   gemini-3.1-flash-image       = Nano Banana 2 (Gemini 3.1 Flash Image) — cheaper / faster
#   gemini-3.1-flash-lite-image  = Nano Banana 2 Lite — cheapest
#   gemini-2.5-flash-image       = older fallback
GEMINI_MODEL=gemini-3-pro-image-preview

# Optional: if the model above is overloaded (503) or rate-limited (429), try these next, in order.
GEMINI_FALLBACK_MODELS=gemini-3.1-flash-image,gemini-2.5-flash-image

# Optional: which storefront origins may call this API (comma-separated).
ALLOWED_ORIGINS=https://pouroveremb.com,https://www.pouroveremb.com
